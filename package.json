{
  "name": "mashup-ours",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "20年分の発明を、もう一度マッシュアップ。ProtoPedia作品の配合から新しい発明アイデアを生み出すサービス",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "node --experimental-strip-types scripts/validate-data.ts",
    "sync:protopedia": "node --experimental-strip-types scripts/sync-protopedia.ts",
    "fetch:sample": "node --experimental-strip-types scripts/fetch-sample-prototypes.mjs",
    "rotate:candidates": "node --experimental-strip-types scripts/rotate-candidates.ts",
    "breed": "node --experimental-strip-types scripts/process-breeding.ts",
    "breed:dry": "node --experimental-strip-types scripts/process-breeding.ts --dry-run",
    "breed:check-ai": "node --experimental-strip-types scripts/process-breeding.ts --check-ai",
    "translate:offspring": "node --experimental-strip-types scripts/translate-offspring.ts",
    "backfill:search-metadata": "node --experimental-strip-types scripts/backfill-search-metadata.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "deploy": "node scripts/deploy.mjs",
    "gitpush": "node scripts/gitpush.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
